FROM node:20-alpine

RUN apk add --no-cache bash openssl python3 make g++ && npm i -g pnpm

WORKDIR /usr/src/app

# Do not run pnpm install here: @myxcrow/shared is a workspace package and
# only exists when the full monorepo is mounted (docker-compose.dev.yml /
# docker-compose.registration.yml).

EXPOSE 3000
CMD ["pnpm", "dev"]
